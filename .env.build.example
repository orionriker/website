# This is just a example env file
# PLEASE DO NOT USE THIS IN PRODUCTION WITHOUT PROPER CONFIGURATION AND TESTING!

IMAGE_ARCH=linux/arm64 # currently supports linux/amd64 and linux/arm64
IMAGE_REGISTRY=registry.example.com # A remote/local registry is required or else signing will not work!

# Base image flavor for the Dockerfile:
#   dhi    (default) Docker Hardened Images, baked into the Dockerfile defaults
#   custom bun-base images (apko/melange builds from ../bun-base), must be
#          published to a registry first: cd ../bun-base && ./build.sh -p $IMAGE_REGISTRY
BASE_FLAVOR=dhi
CUSTOM_BUILDER_IMAGE=registry.example.com/bun-dev:1.4.0     # only needed when BASE_FLAVOR=custom
CUSTOM_RUNTIME_IMAGE=registry.example.com/bun-runtime:1.4.0 # only needed when BASE_FLAVOR=custom

COSIGN_PASSWORD=my-super-secret-password # Use yours
COSIGN_PRIVATE=/path/to/cosign/private/key # Use yours