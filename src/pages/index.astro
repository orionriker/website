---
import Layout from '@layouts/Layout.astro'
import Hero from '@components/Hero'
import SkillsTabs from '@components/SkillsTabs'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

import ImageTechStack from '@images/tech-stack.svg'
---

<Layout
    title="Orion C. Riker"
    description="Orion C. Riker's portfolio"
    page="home"
>
    <section
        class="page-container h-[calc(100vh-60px)] flex flex-col justify-center"
        id="hero"
    >
        <Hero client:load />
    </section>
    <section class="page-container py-16" id="about">
        <h2 class="page-home-section-heading">
            <Icon name="mdi:account-circle-outline" size="40" />
            About Me
        </h2>
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 text-lg"
        >
            <div class="card md:col-span-2 shadow">
                <div class="card-content z-10 mt-0!">
                    <p class="font-medium mb-4">
                        I'm a {
                            Math.floor(
                                (Date.now() - 1246406400000) /
                                    (1000 * 60 * 60 * 24 * 365.25)
                            )
                        }-year-old full-stack developer based in Bengaluru with
                        6 years of experience. I build Websites, APIs, Android
                        apps, .NET software, AI products, and whatever else
                        needs building. I design in Figma and implement what I
                        design — no handoff. Game development is also something
                        I do: I work across Unity, Unreal, and Godot, mostly all
                        personal projects. I also work with electronics —
                        soldering, circuit design, and connecting sensors
                        directly to mains AC and integrate them into Home
                        Assistant. And 3D printing: mostly functional parts I've
                        designed to make daily life easier.
                    </p>
                    <p class="font-medium mb-4">
                        I also run a homelab: Proxmox hosting TrueNAS across
                        16TB of total storage with ZFS RAIDZ2. Day-to-day it
                        runs Immich, Bitwarden, GitLab, Grafana, Pi-hole,
                        Technitium DNS, and Tailscale so I can reach everything
                        remotely.
                    </p>
                    <p class="font-medium mb-4">
                        I run Arch Linux. Everything I rely on is open source.
                        Also love video games! Video games are why I started
                        coding — Counter-Strike, Minecraft, Hytale are some
                        which I play or played.
                    </p>
                    <p class="font-medium">
                        This portfolio runs on a 2-node Kubernetes cluster with
                        Caddy as the reverse proxy — deployed via FluxCD and
                        custom CI/CD scripts. I'm a strong advocate for DevOps
                        practices; GitOps and automation are how I keep
                        production sane.
                    </p>
                </div>
            </div>
            <div class="card shadow h-fit">
                <div class="card-content z-10 mt-0!">
                    <p class="font-semibold mb-3">Currently</p>
                    <ul class="font-medium space-y-2 text-base">
                        <li>🛠️ Building this portfolio</li>
                        <li>🎮 Learning Godot</li>
                        <li>📖 Exploring AI/ML</li>
                    </ul>
                </div>
            </div>
            <div class="card shadow">
                <div class="card-content z-10 mt-0!">
                    <p class="font-medium">
                        You can contact me via <a
                            href="https://linkedin.com/in/orionriker"
                            target="_blank"
                            class="underline decoration-accent decoration-2 underline-offset-2"
                            >LinkedIn</a
                        >, or you can email me
                        <a
                            href="mailto:orionriker@proton.me"
                            class="underline decoration-accent decoration-2 underline-offset-2"
                            >orionriker@proton.me</a
                        >, or use any of the social media buttons.
                    </p>
                </div>
            </div>
        </div>
    </section>
    <section class="page-container py-16" id="skills">
        <h2 class="page-home-section-heading">
            <Icon name="mdi:xml" size="40" />
            Skills & Expertise
        </h2>
        <div class="image-wrapper loading mb-12">
            <Image
                src={ImageTechStack}
                alt="Tech Stack"
                loading={'lazy'}
                width={1496}
                height={736}
                onload="this.parentElement.classList.remove('loading')"
            />
        </div>
        <SkillsTabs client:visible />
    </section>
</Layout>
