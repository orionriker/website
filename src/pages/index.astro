---
import Layout from '@layouts/Layout.astro'
import Hero from '@components/Hero'
import SkillsTabs from '@components/SkillsTabs'
import Icon from '@components/Icon'
import { Image } from 'astro:assets'

import ImageTechStack from '@images/tech-stack.svg'

const MyAge = Math.floor(
    (Date.now() - 1246406400000) / (1000 * 60 * 60 * 24 * 365.25)
)
---

<Layout
    title="Orion C. Riker"
    description="Orion C. Riker's portfolio"
    page="home"
>
    <section
        class="page-container h-[calc(100vh-60px)] flex flex-col justify-center"
        id="hero"
    >
        <Hero client:load transition:persist />
    </section>
    <section class="page-container py-16" id="about">
        <h2 class="page-home-section-heading">
            <Icon client:visible name="mdi:account-circle-outline" size={38} />
            About Me
        </h2>
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 xl:text-lg"
        >
            <div class="card md:col-span-2">
                <div class="card-content">
                    <p>
                        I'm a {MyAge}-year-old Full Stack Developer.
                        Federationist. Designer. Maker. Based in Bengaluru,
                        coding since age 10. I build websites, APIs, Android
                        apps, .NET software, AI products, and whatever else
                        needs building. Every design starts in Figma before
                        becoming code. Game development is another interest; I
                        build games using Unity, Unreal, and Godot. I also work
                        with electronics, soldering, circuit design, building
                        mains-powered IoT devices that integrate with Home
                        Assistant, and occasionally make friends with 230V AC. I
                        also design and manufacture custom parts using 3D
                        printing.
                    </p>
                    <p>
                        My homelab runs Proxmox with TrueNAS across 16TB of
                        total storage with ZFS RAIDZ2. Among the services it
                        runs are Immich, Bitwarden, GitLab, Grafana, Pi-hole,
                        Technitium DNS. I use Tailscale so I can reach
                        everything remotely, without port forwarding.
                    </p>
                    <p>
                        I study governance, track current affairs, and think
                        about rights and law. I'm a citizen of Earth before
                        anything else. The nation-state system was never built
                        for the problems we face today. The United Federation of
                        Earth is what I'm building to replace it: a world
                        government to eventually replace nation-states. It has a
                        quadricameral (four-chamber) legislature, branches that
                        can check and remove each other, anti-corruption in the
                        architecture itself, and things most governments still
                        treat as negotiable: same and equal rights for every
                        human on Earth, free healthcare, free public transport
                        all guaranteed in the constitution itself.
                    </p>
                    <p>
                        Arch Linux is my daily operating system. Everything I
                        rely on is open source. I also love to play video games;
                        they are what got me into the rabbit hole of
                        programming: Counter-Strike 2, Minecraft, Terraria,
                        Hytale, and indie games in general. I constantly try new
                        games, but those are what I always return to.
                    </p>
                    <p>
                        This personal website runs on a 2-node Kubernetes
                        cluster with Caddy as the reverse proxy, deployed using
                        FluxCD and custom CI/CD scripts.
                    </p>
                </div>
            </div>
            <div
                class="flex flex-col gap-6 md:contents lg:flex lg:flex-col lg:gap-6"
            >
                <div class="card h-fit">
                    <h1 class="card-title">Current Focus</h1>
                    <div class="card-content">
                        <ul class="space-y-2">
                            <li>🌍 United Federation of Earth</li>
                            <li>☸️ Kubernetes & DevOps</li>
                            <li>🤖 AI Applications</li>
                            <li>🏠 Self-Hosting & Infrastructure</li>
                        </ul>
                    </div>
                </div>
                <div class="card">
                    <h1 class="card-title">Contact</h1>
                    <div class="card-content">
                        <p>
                            You can contact me via <a
                                href="https://linkedin.com/in/orionriker"
                                target="_blank"
                                class="link underline-offset-2">LinkedIn</a
                            >, or you can email me{' '}
                            <a
                                href="mailto:orionriker@proton.me"
                                class="link underline-offset-2"
                                >orionriker@proton.me</a
                            >, or use any of the social media buttons (located
                            in the footer and hero section).
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="page-container py-16" id="skills">
        <h2 class="page-home-section-heading">
            <Icon client:visible name="mdi:xml" size={38} />
            Skills & Expertise
        </h2>
        <div class="image-wrapper loading mb-12">
            <Image
                src={ImageTechStack}
                alt="Tech Stack"
                loading={'lazy'}
                width={1496}
                height={736}
                onload="this.parentElement.classList.remove('loading')"
            />
        </div>
        <SkillsTabs client:visible />
    </section>
</Layout>
