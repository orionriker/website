---

<div class="manifest">
    {
        categories.map((category) => (
            <div class="manifest__group">
                <h3 class="manifest__name">{category.label}</h3>
                {levelOrder.map((level) => {
                    const skills = category.skills.filter(
                        (s) => s.level === level
                    )
                    if (skills.length === 0) return null
                    const isPast = level === 'PreviouslyUsed'
                    return (
                        <div>
                            <span class="manifest__level">
                                {levelLabels[level]}
                            </span>
                            <ul
                                class={`manifest__items ${isPast ? 'manifest__items--past' : ''}`}
                            >
                                {skills.map((skill) => (
                                    <li>{skill.name}</li>
                                ))}
                            </ul>
                        </div>
                    )
                })}
            </div>
        ))
    }
</div>
