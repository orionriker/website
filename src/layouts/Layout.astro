---
import { ClientRouter } from 'astro:transitions'
import '@styles/global.css'

import Navbar from '@components/Navbar'

import Icon from '@components/Icon'

interface Props {
    title: string
    description?: string
    page: string
    NoFooter?: boolean
    NoNavbar?: boolean
    AltFooter?: boolean
}

// @ts-ignore
const { title, description, page, NoFooter, NoNavbar, AltFooter } = Astro.props
---

<!doctype html>
<html data-theme="auto" class="bg-base-950" lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <meta name="color-scheme" content="dark light" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.gstatic.com/s/monasans/v4/o-0bIpQmx24alC5A4PNB6Ryti20_6n1iPHjc5a7duw.woff2"
            rel="preload"
            as="font"
            crossorigin
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Mona+Sans:ital,wght@0,200..900;1,200..900&display=swap"
            rel="stylesheet"
        />
        <title>{title}</title>
        <ClientRouter />
        <script is:inline async>
            const applyTheme = () => {
                let e = document.documentElement,
                    t = localStorage.getItem('theme')
                if ('dark' === t || 'light' === t)
                    e.setAttribute('data-theme', t)
                else {
                    let a = matchMedia('(prefers-color-scheme: dark)').matches
                    e.setAttribute('data-theme', a ? 'dark' : 'light')
                }
            }
            ;(applyTheme(),
                document.addEventListener('astro:after-swap', applyTheme),
                document.addEventListener('astro:page-load', applyTheme))
        </script>
    </head>
    <body class="min-h-screen">
        {!NoNavbar && <Navbar client:visible />}

        <div
            class={AltFooter && !NoFooter
                ? 'min-h-[calc(100vh-72px)]'
                : 'min-h-[calc(100vh-245px)]'}
        >
            <slot />
        </div>

        {
            (!NoFooter && (
                <div class="page-container">
                    <footer class="footer">
                        <div class="text-center pb-6">
                            <a class="normal-case text-4xl font-bold" href="/">
                                Orion C. Riker
                            </a>
                            <ul class="flex justify-center gap-5 px-1 py-5 text-sm font-semibold">
                                <li>
                                    <a
                                        class="transition-colors duration-300 hover:text-base-400"
                                        href="/"
                                    >
                                        Home
                                    </a>
                                </li>
                                <li>
                                    <a
                                        class="transition-colors duration-300 hover:text-base-400"
                                        href="/projects"
                                    >
                                        Projects
                                    </a>
                                </li>
                                <li>
                                    <a
                                        class="transition-colors duration-300 hover:text-base-400"
                                        href="/#about"
                                    >
                                        About
                                    </a>
                                </li>
                            </ul>
                            <div class="flex justify-center gap-2">
                                <a
                                    aria-label="Email"
                                    href="mailto:orionriker@proton.me"
                                    class="hero-chip-container group"
                                >
                                    <span class="hero-chip p-2.5! chip">
                                        <Icon
                                            client:visible
                                            name="mdi:email"
                                            size={20}
                                        />
                                    </span>
                                </a>
                                <a
                                    aria-label="Github"
                                    href="https://github.com/orionriker"
                                    target="_blank"
                                    class="hero-chip-container group"
                                >
                                    <span class="hero-chip p-2.5! chip">
                                        <Icon
                                            client:visible
                                            name="mdi:github"
                                            size={20}
                                        />
                                    </span>
                                </a>
                                <a
                                    aria-label="StackOverflow"
                                    href="https://stackoverflow.com/users/27994192/orionriker"
                                    target="_blank"
                                    class="hero-chip-container group"
                                >
                                    <span class="hero-chip p-2.5! chip">
                                        <Icon
                                            client:visible
                                            name="mdi:stack-overflow"
                                            size={20}
                                        />
                                    </span>
                                </a>
                                <a
                                    aria-label="Twitter/X"
                                    href="https://twitter.com/orionriker"
                                    target="_blank"
                                    class="hero-chip-container group"
                                >
                                    <span class="hero-chip p-2.5! chip">
                                        <Icon
                                            client:visible
                                            name="cib:twitter"
                                            size={20}
                                        />
                                    </span>
                                </a>
                                <a
                                    aria-label="Reddit"
                                    href="https://reddit.com/u/rikerorion"
                                    target="_blank"
                                    class="hero-chip-container group"
                                >
                                    <span class="hero-chip p-2.5! chip">
                                        <Icon
                                            client:visible
                                            name="cib:reddit"
                                            size={20}
                                        />
                                    </span>
                                </a>
                                <a
                                    aria-label="LinkedIn"
                                    href="https://www.linkedin.com/in/orionriker/"
                                    target="_blank"
                                    class="hero-chip-container group"
                                >
                                    <span class="hero-chip p-2.5! chip">
                                        <Icon
                                            client:visible
                                            name="cib:linkedin"
                                            size={20}
                                        />
                                    </span>
                                </a>
                            </div>
                        </div>
                        <div class="border-t border-base-800 pt-6">
                            <div class="font-mono flex flex-col gap-4 text-center lg:flex-row lg:justify-between">
                                <p>
                                    © {new Date().getFullYear()} Orion C. Riker.
                                    All rights reserved.
                                </p>
                                <p>
                                    Built using{' '}
                                    <a
                                        href="https://astro.build/"
                                        class="text-base-400 hover:underline decoration-wavy"
                                    >
                                        Astro
                                    </a>{' '}
                                    +{' '}
                                    <a
                                        href="https://preactjs.com/"
                                        class="text-base-400 hover:underline decoration-wavy"
                                    >
                                        Preact
                                    </a>{' '}
                                    +{' '}
                                    <a
                                        href="https://tailwindcss.com/"
                                        class="text-base-400 hover:underline decoration-wavy"
                                    >
                                        TailwindCSS
                                    </a>{' '}
                                    +{' '}
                                    <a
                                        href="https://motion.dev/"
                                        class="text-base-400 hover:underline decoration-wavy"
                                    >
                                        Framer Motion
                                    </a>
                                </p>
                            </div>
                        </div>
                    </footer>

                    <div class="text-center text-base-400 mb-5">
                        <p>
                            Licensed under GNU General Public License v3.0
                            <a
                                class="text-accent-500 ml-4 inline"
                                href="https://github.com/orionriker/website"
                            >
                                Source{' '}
                                <Icon
                                    client:visible
                                    name="mdi:open-in-new"
                                    class="inline"
                                    size={16}
                                />
                            </a>
                        </p>
                    </div>
                </div>
            )) ||
                (!NoFooter && !AltFooter ? null : (
                    <footer class="footer py-5 px-4 shadow bg-base-950 bottom-0 mt-auto shrink-0">
                        <div class="text-center text-gray-500">
                            <p>
                                © {new Date().getFullYear()} Orion C. Riker. All
                                rights reserved.
                            </p>
                        </div>
                    </footer>
                ))
        }
    </body><script is:inline defer>
        const initThemeControls = () => {
                try {
                    let t = document.documentElement,
                        e = document.getElementById('theme-light-btn'),
                        a = document.getElementById('theme-dark-btn'),
                        n = (e) => {
                            try {
                                ;(('dark' === e || 'light' === e) &&
                                    (localStorage.setItem('theme', e),
                                    t.setAttribute('data-theme', e)),
                                    r(e))
                            } catch (a) {
                                console.error('setTheme error', a)
                            }
                        },
                        r = (t) => {
                            ;(e?.classList.remove(
                                'bg-accent-800',
                                'text-white'
                            ),
                                a?.classList.remove(
                                    'bg-accent-800',
                                    'text-white'
                                ),
                                'light' === t &&
                                    e?.classList.add(
                                        'bg-accent-800',
                                        'text-white'
                                    ),
                                'dark' === t &&
                                    a?.classList.add(
                                        'bg-accent-800',
                                        'text-white'
                                    ))
                        }
                    ;(e &&
                        !e.dataset.themeInit &&
                        (e.addEventListener('click', () => n('light')),
                        (e.dataset.themeInit = 'true')),
                        a &&
                            !a.dataset.themeInit &&
                            (a.addEventListener('click', () => n('dark')),
                            (a.dataset.themeInit = 'true')))
                    let i = t.getAttribute('data-theme')
                    ;('dark' === i || 'light' === i) && r(i)
                } catch (s) {
                    console.error('initThemeControls', s)
                }
            },
            onNav = () => requestAnimationFrame(initThemeControls)
        let onStorage = (t) => {
            'theme' === t.key && initThemeControls()
        }
        ;(initThemeControls(),
            document.addEventListener('astro:after-swap', onNav),
            document.addEventListener('astro:page-load', initThemeControls),
            window.addEventListener('storage', onStorage))
    </script>
</html>
